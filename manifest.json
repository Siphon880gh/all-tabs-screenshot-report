{
  "manifest_version": 3,
  "name": "CE Extension",
  "version": "0.1.0",
  "description": "Chrome extension scaffolding — tab control and screenshots",
  "permissions": ["tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CE Extension"
  }
}
